---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="shell">
    <!-- Hark-style floating top bar: round button · pill · session -->
    <header class="topbar">
      <div class="bar-left">
        <button id="refresh" class="glass round" aria-label="刷新">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 5v6h-6"/></svg>
        </button>
        <button id="cal-sub" class="glass round" aria-label="订阅到日历" hidden>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/><path d="M12 13v5"/><path d="M9.5 15.5h5"/></svg>
        </button>
      </div>
      <nav class="glass pill">
        <span class="seg active">首页</span>
      </nav>
      <div class="account">
        <button type="button" id="login-btn" class="glass account-btn">登录</button>
        <span id="account-avatar" class="account-avatar" hidden>
          <img src="/avatar.jpg" alt="" width="36" height="36" />
        </span>
        <button type="button" id="logout-btn" class="glass account-btn" hidden>退出</button>
      </div>
    </header>

    <main>
      <hgroup class="hello">
        <h1 id="greeting" class="greeting"></h1>
        <p id="clock" class="date"></p>
      </hgroup>
      <div id="cards" class="cards"></div>
    </main>
  </div>

  <dialog id="login-dialog" class="login-dialog" aria-labelledby="login-title">
    <form id="login-form" class="login-card" method="post" action="#">
      <h2 id="login-title">登录</h2>
      <p class="login-hint">输入 AGENT_TOKEN。登录后会在这台设备记住约 30 天，桌面快捷方式不用把口令写进网址。</p>
      <input id="login-token" name="token" type="password" autocomplete="current-password" spellcheck="false" required aria-label="AGENT_TOKEN" />
      <p id="login-error" class="login-error" role="alert" hidden></p>
      <div class="login-actions">
        <button type="button" id="login-cancel" class="login-secondary">取消</button>
        <button type="submit" id="login-submit" class="login-primary">登录</button>
      </div>
    </form>
  </dialog>

  <dialog id="note-dialog" class="login-dialog" aria-labelledby="note-title">
    <form id="note-form" class="login-card" method="dialog">
      <h2 id="note-title">完成了，记一笔？</h2>
      <p class="login-hint note-task" id="note-task"></p>
      <input id="note-input" name="note" type="text" autocomplete="off" spellcheck="false" maxlength="500" placeholder="实际做了什么（可留空跳过）" aria-label="完成备注" />
      <div class="login-actions">
        <button type="button" id="note-skip" class="login-secondary">跳过</button>
        <button type="submit" id="note-submit" class="login-primary" value="note">记下</button>
      </div>
    </form>
  </dialog>

  <script>
    import { registry } from '../widgets/registry';
    import { generic } from '../widgets/generic';
    import { esc, timeAgo } from '../widgets/ui';
    import type { Widget, WidgetDef } from '../widgets/types';

    const cardsEl = document.getElementById('cards')!;
    const known = new Map(registry.map((d) => [d.id, d]));
    // Retired widgets: their old D1 rows may linger — never render them.
    // 'calendar'/'courses' are hidden feed rows for /api/calendar.ics, not cards.
    const RETIRED = new Set(['stocks', 'calendar', 'courses']);

    const defFor = (id: string, title?: string): WidgetDef =>
      known.get(id) ?? { ...generic, id, title: title ?? id };

    // Get-or-create the card shell for a widget; body/stamp filled by caller.
    function cardFor(def: WidgetDef): HTMLElement {
      let card = cardsEl.querySelector<HTMLElement>(`[data-widget="${CSS.escape(def.id)}"]`);
      if (card) return card;
      card = document.createElement('section');
      card.className = 'card';
      card.dataset.widget = def.id;
      card.innerHTML = `
        <header class="card-head">
          <span class="card-icon">${def.icon}</span>
          <h2 class="card-title">${esc(def.title)}</h2>
          <span class="card-time" data-role="updated"></span>
        </header>
        <div class="card-body" data-role="body"><div class="skeleton"><i></i><i></i></div></div>`;
      cardsEl.append(card);
      sizer.observe(card);
      return card;
    }

    // Desktop masonry: span = card height + 20px gap, in 4px grid rows (see global.css).
    const desktop = matchMedia('(min-width: 760px)');
    const sizer = new ResizeObserver((entries) => {
      for (const { target } of entries) {
        const el = target as HTMLElement;
        el.style.gridRowEnd = desktop.matches ? `span ${Math.ceil((el.offsetHeight + 20) / 4)}` : '';
      }
    });
    registry.forEach(cardFor);

    function paint(def: WidgetDef, w: Widget | undefined) {
      const card = cardFor(def);
      card.querySelector('.card-title')!.textContent = w?.title || def.title;
      card.querySelector('[data-role="updated"]')!.textContent = w ? timeAgo(w.updated_at) : '';
      let html: string;
      try {
        html = def.render(w ? w.data : null);
      } catch {
        html = generic.render(w?.data ?? null); // a broken renderer shouldn't blank the card
      }
      const body = card.querySelector<HTMLElement>('[data-role="body"]')!;
      const page = Number(body.dataset.page ?? 0);
      body.innerHTML = html;
      showPage(body, page); // a poll re-render shouldn't jump back to page 1
    }

    // Paged lists (ui.ts `paged`): one <ul data-page> per page, only one visible.
    function showPage(body: HTMLElement, n: number) {
      const pages = body.querySelectorAll<HTMLElement>('[data-page]');
      if (!pages.length) return;
      const i = Math.min(Math.max(n, 0), pages.length - 1);
      pages.forEach((p, k) => (p.hidden = k !== i));
      body.dataset.page = String(i);
      body.querySelector('[data-role="page-num"]')!.textContent = `${i + 1} / ${pages.length}`;
      body.querySelector<HTMLButtonElement>('[data-pager="-1"]')!.disabled = i === 0;
      body.querySelector<HTMLButtonElement>('[data-pager="1"]')!.disabled = i === pages.length - 1;
    }

    // ── session ──────────────────────────────────────────────────────────
    // HttpOnly cookie set by POST /api/login. The page only learns whether
    // it is signed in via GET /api/session. A legacy localStorage token (or
    // ?token= if the worker redirect didn't already consume it) is exchanged
    // once, then dropped. Desktop shortcuts do not need the token in the URL.
    const LEGACY_TOKEN_KEY = 'pulse_token';
    let loggedIn = false;

    function renderSession() {
      document.getElementById('login-btn')!.hidden = loggedIn;
      document.getElementById('account-avatar')!.hidden = !loggedIn;
      document.getElementById('logout-btn')!.hidden = !loggedIn;
      document.getElementById('cal-sub')!.hidden = !loggedIn;
    }

    function showLoginError(message: string) {
      const el = document.getElementById('login-error')!;
      el.textContent = message;
      el.hidden = message.length === 0;
    }

    function legacyToken(): string | null {
      try {
        return localStorage.getItem(LEGACY_TOKEN_KEY);
      } catch {
        return null;
      }
    }

    function clearLegacyToken() {
      try {
        localStorage.removeItem(LEGACY_TOKEN_KEY);
      } catch {
        /* private mode */
      }
    }

    function stripTokenParam() {
      const url = new URL(location.href);
      if (!url.searchParams.has('token')) return;
      url.searchParams.delete('token');
      history.replaceState(null, '', url.pathname + url.search + url.hash);
    }

    function postLogin(token: string) {
      return fetch('/api/login', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
    }

    // Capture ?token= before stripping it. A network failure leaves the param
    // in place so a reload can retry; a response (even 401/429) clears it.
    async function adoptExistingToken() {
      const urlToken = new URL(location.href).searchParams.get('token');
      const legacy = legacyToken();
      if (urlToken) {
        try {
          const res = await postLogin(urlToken);
          if (res.ok || res.status === 401 || res.status === 429) stripTokenParam();
          if (res.ok || (res.status === 401 && legacy === urlToken)) clearLegacyToken();
          if (res.ok) return;
          if (res.status !== 401) return;
        } catch {
          return;
        }
      }
      if (legacy && legacy !== urlToken) {
        try {
          const res = await postLogin(legacy);
          if (res.ok || res.status === 401) clearLegacyToken();
        } catch {
          /* keep the legacy token for the next load */
        }
      }
    }

    async function refreshSession() {
      try {
        const res = await fetch('/api/session', { credentials: 'same-origin', cache: 'no-store' });
        const body = await res.json();
        loggedIn = body?.authenticated === true;
      } catch {
        loggedIn = false;
      }
      renderSession();
    }

    async function bootstrapSession() {
      await adoptExistingToken();
      await refreshSession();
    }

    const sessionReady = bootstrapSession();

    const loginDialog = document.getElementById('login-dialog') as HTMLDialogElement;
    document.getElementById('login-btn')!.addEventListener('click', () => {
      showLoginError('');
      (document.getElementById('login-token') as HTMLInputElement).value = '';
      loginDialog.showModal();
    });
    document.getElementById('login-cancel')!.addEventListener('click', () => loginDialog.close());
    loginDialog.addEventListener('close', () => {
      (document.getElementById('login-token') as HTMLInputElement).value = '';
      showLoginError('');
    });
    document.getElementById('login-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('login-token') as HTMLInputElement;
      const submit = document.getElementById('login-submit') as HTMLButtonElement;
      const token = input.value;
      if (!token) return;
      showLoginError('');
      submit.disabled = true;
      try {
        const res = await postLogin(token);
        if (res.ok) {
          loggedIn = true;
          renderSession();
          loginDialog.close();
          return;
        }
        if (res.status === 429) {
          const retry = Number(res.headers.get('Retry-After'));
          showLoginError(
            Number.isFinite(retry) && retry > 0
              ? `尝试太频繁，请 ${retry} 秒后再试`
              : '尝试太频繁，请稍后再试',
          );
        } else {
          showLoginError('口令不正确');
        }
      } catch {
        showLoginError('网络异常，请重试');
      } finally {
        submit.disabled = false;
      }
    });
    document.getElementById('logout-btn')!.addEventListener('click', async () => {
      try {
        await fetch('/api/logout', { method: 'POST', credentials: 'same-origin' });
      } catch {
        /* still drop the local signed-in state */
      }
      loggedIn = false;
      renderSession();
    });

    let refreshInflight = 0;

    // Client-side serialization is only a courtesy — POST /api/todo/toggle
    // does the flip inside the Worker so the server is the real serialization
    // point. todoMutationGen guards refresh() from repainting stale poll data
    // over a newer toggle result.
    let toggleQueue: Promise<void> = Promise.resolve();
    let todoMutationGen = 0;
    const lastToggle = new Map<string, boolean>();

    cardsEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-pager]');
      const body = btn?.closest<HTMLElement>('[data-role="body"]');
      if (btn && body) showPage(body, Number(body.dataset.page ?? 0) + Number(btn.dataset.pager));

      // Only inside the todo card — other widgets reuse .w-todo rows.
      const check = (e.target as HTMLElement).closest<HTMLElement>('[data-widget="todo"] .w-check[data-id]');
      if (check?.dataset.id) toggleTodo(check.dataset.id, check);
    });

    // Completion note: checking an item opens a skippable prompt (Enter =
    // 记下, Esc/backdrop/跳过 = close with no note). The note rides the same
    // toggle POST so it lands on the task row atomically with the done
    // write — no second call to split them. Undo never prompts.
    const noteDialog = document.getElementById('note-dialog') as HTMLDialogElement;
    const noteInput = document.getElementById('note-input') as HTMLInputElement;
    document.getElementById('note-skip')!.addEventListener('click', () => noteDialog.close());
    noteDialog.addEventListener('click', (e) => {
      if (e.target === noteDialog) noteDialog.close(); // backdrop click
    });

    function askCompletionNote(title: string): Promise<string | undefined> {
      return new Promise((resolve) => {
        document.getElementById('note-task')!.textContent = `「${title}」`;
        noteInput.value = '';
        noteDialog.returnValue = '';
        noteDialog.addEventListener('close', () => {
          const t = noteInput.value.trim();
          resolve(noteDialog.returnValue === 'note' && t ? t : undefined);
        }, { once: true });
        noteDialog.showModal();
        noteInput.focus();
      });
    }

    // Flip one item's done state: one POST, repaint the todo card from the
    // response. Signed out, it's a local-only flip (gone on refresh) with
    // a shake to hint it didn't persist.
    async function toggleTodo(id: string, el: HTMLElement) {
      await sessionReady;
      if (!loggedIn) {
        el.closest('.w-todo')?.classList.toggle('is-done');
        el.classList.add('w-shake');
        setTimeout(() => el.classList.remove('w-shake'), 400);
        return;
      }
      // Track the last requested state per item — rapid clicks on the same
      // circle must see each other's intent (check→undo→check serializes
      // through toggleQueue so the final write wins).
      const nowDone = !(lastToggle.get(id) ?? el.closest('.w-todo')?.classList.contains('is-done'));
      lastToggle.set(id, nowDone);
      todoMutationGen++;
      const title = el.closest('.w-todo')?.querySelector('.w-todo-title')?.textContent ?? '';
      toggleQueue = toggleQueue.then(async () => {
        const note = nowDone ? await askCompletionNote(title) : undefined;
        return doToggle(id, nowDone, note);
      }).catch(() => {});
    }

    async function doToggle(id: string, nowDone: boolean, note?: string) {
      const res = await fetch('/api/todo/toggle', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, done: nowDone, ...(note ? { note } : {}) }),
      });
      if (res.status === 401) {
        loggedIn = false;
        renderSession();
      }
      if (!res.ok) {
        // The intent never landed — drop it so a retry click recomputes from
        // the DOM instead of inverting off stale memory.
        if (lastToggle.get(id) === nowDone) lastToggle.delete(id);
        return; // keep polling view; the next poll repaints from D1
      }
      paint(defFor('todo'), await res.json());
      // The DOM now reflects this toggle — the next click can read it again.
      if (lastToggle.get(id) === nowDone) lastToggle.delete(id);
    }

    async function refresh() {
      const gen = todoMutationGen; // snapshot before the fetch
      let widgets: Widget[];
      try {
        const res = await fetch('/api/widgets');
        if (!res.ok) return; // keep previous render; retry next poll
        widgets = await res.json();
      } catch {
        return;
      }
      const byId = new Map(widgets.map((w) => [w.id, w]));
      registry.forEach((d) => {
        // A poll fetched before a toggle landed carries stale todo data —
        // skip repainting that card if a mutation started mid-fetch.
        if (d.id === 'todo') {
          if (todoMutationGen !== gen) return;
          lastToggle.clear(); // fresh server truth rendered — drop click memory
        }
        paint(d, byId.get(d.id));
      });
      widgets.filter((w) => !known.has(w.id) && !RETIRED.has(w.id)).forEach((w) => paint(defFor(w.id, w.title), w));
    }

    function tick() {
      const d = new Date();
      const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
      document.getElementById('clock')!.textContent =
        `${days[d.getDay()]} ${d.getMonth() + 1}月${d.getDate()}日`;
      const h = d.getHours();
      document.getElementById('greeting')!.textContent =
        h < 5 ? '夜深了' : h < 11 ? '早上好' : h < 13 ? '中午好' : h < 18 ? '下午好' : '晚上好';
    }

    // Opens iOS Calendar's subscribe sheet via the token-bearing webcal URL
    // the worker hands to signed-in sessions only (the cookie hides the token).
    document.getElementById('cal-sub')!.addEventListener('click', async () => {
      try {
        const res = await fetch('/api/calendar-link', { credentials: 'same-origin' });
        if (!res.ok) return;
        const { subscribe } = await res.json();
        if (typeof subscribe === 'string' && subscribe) location.href = subscribe;
      } catch {
        /* offline — nothing to subscribe to anyway */
      }
    });

    const btn = document.getElementById('refresh')!;
    btn.addEventListener('click', async () => {
      refreshInflight++;
      btn.classList.add('spin');
      try {
        await refresh();
      } finally {
        refreshInflight--;
        if (refreshInflight === 0) {
          setTimeout(() => {
            if (refreshInflight === 0) btn.classList.remove('spin');
          }, 500);
        }
      }
    });

    tick();
    setInterval(tick, 60_000);
    refresh();
    setInterval(refresh, 60_000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refresh();
    });
  </script>
</Layout>
