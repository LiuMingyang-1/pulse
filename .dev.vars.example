# Dev-only secrets. Copy to .dev.vars (gitignored).
# Production tokens are set via `wrangler secret put <NAME>`.
#
# This file is loaded by `wrangler dev` automatically, AND by push scripts
# like scripts/sync-courses.mjs (PULSE_TOKEN falls back to AGENT_TOKEN).

AGENT_TOKEN=dev-token-change-me

# Push scripts (sync-courses.mjs etc.) — PULSE_URL points at your deployed
# worker (defaults to localhost:8787), PULSE_TOKEN defaults to AGENT_TOKEN,
# PULSE_SOURCE tags pushed rows' `source` field.
PULSE_URL=
# PULSE_TOKEN=
# PULSE_SOURCE=

# Optional widget push keys (e.g. Finnhub for the stocks script).
FINNHUB_API_KEY=
